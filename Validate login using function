#include <stdio.h>
#include <string.h>

int login(char u[], char p[]) {
    return strcmp(u, "admin") == 0 && strcmp(p, "123") == 0;
}

int main() {
    char user[20], pass[20];
    scanf("%s %s", user, pass);

    if (login(user, pass))
        printf("Login Successful");
    else
        printf("Invalid Login");
    return 0;
}

