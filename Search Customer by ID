#include <stdio.h>
struct cust{int id; char name[20];};
int main(){
    struct cust c[5]; int i,n,id;
    scanf("%d",&n);
    for(i=0;i<n;i++) scanf("%d %s",&c[i].id,c[i].name);
    scanf("%d",&id);
    for(i=0;i<n;i++)
        if(c[i].id==id){ printf("%s",c[i].name); return 0; }
    printf("Not Found");
    return 0;
}
